<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Company>Starfall</Company>
    <Product>Starfall</Product>
    <Authors>Starfall</Authors>
    <StarfallRepositoryRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)'))</StarfallRepositoryRoot>
    <ChronoFallFamilyRoot Condition="'$(ChronoFallFamilyRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))</ChronoFallFamilyRoot>
  </PropertyGroup>
</Project>
