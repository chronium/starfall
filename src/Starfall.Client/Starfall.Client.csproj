<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ChronoFallEffectiveRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</ChronoFallEffectiveRuntimeIdentifier>
    <ChronoFallEffectiveRuntimeIdentifier Condition="'$(ChronoFallEffectiveRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</ChronoFallEffectiveRuntimeIdentifier>
    <StarfallCharacterStageRoot>$(StarfallRepositoryRoot)artifacts/chronofall/character-presentation/client/</StarfallCharacterStageRoot>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Starfall.Client.Tests" />
    <InternalsVisibleTo Include="Starfall.ConnectedWalking.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Starfall.Content/Starfall.Content.csproj" />
    <ProjectReference Include="../Starfall.Protocol/Starfall.Protocol.csproj" />
    <ProjectReference Include="$(ChronoFallFamilyRoot)src/ChronoFall.CharacterPresentation/ChronoFall.CharacterPresentation.csproj"
                      AdditionalProperties="ShouldUnsetParentConfigurationAndPlatform=false" />
    <ProjectReference Include="$(ChronoFallFamilyRoot)src/ChronoFall.CharacterPresentation.Cooking/ChronoFall.CharacterPresentation.Cooking.csproj"
                      AdditionalProperties="ShouldUnsetParentConfigurationAndPlatform=false" />
    <ProjectReference Include="$(ChronoFallFamilyRoot)src/ChronoFall.CharacterPresentation.SdlGpu/ChronoFall.CharacterPresentation.SdlGpu.csproj"
                      AdditionalProperties="ShouldUnsetParentConfigurationAndPlatform=false" />
    <ProjectReference Include="$(ChronoFallFamilyRoot)src/ChronoFall.EditorUi.SdlGpu/ChronoFall.EditorUi.SdlGpu.csproj"
                      AdditionalProperties="ShouldUnsetParentConfigurationAndPlatform=false" />
    <ProjectReference Include="$(ChronoFallFamilyRoot)src/ChronoFall.Network.Transport.LiteNetLib/ChronoFall.Network.Transport.LiteNetLib.csproj"
                      AdditionalProperties="ShouldUnsetParentConfigurationAndPlatform=false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(StarfallCharacterStageRoot)quaternius-ual1-standard.cfskel"
          Link="content/chronofall/character-presentation/client/quaternius-ual1-standard.cfskel"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(StarfallCharacterStageRoot)quaternius-ual1-standard.provenance.json"
          Link="content/chronofall/character-presentation/client/quaternius-ual1-standard.provenance.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(StarfallCharacterStageRoot)quaternius-ual2-source-bow-shot-body.cfskel"
          Link="content/chronofall/character-presentation/client/quaternius-ual2-source-bow-shot-body.cfskel"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(StarfallCharacterStageRoot)quaternius-ual2-source-bow-shot-body.provenance.json"
          Link="content/chronofall/character-presentation/client/quaternius-ual2-source-bow-shot-body.provenance.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(StarfallCharacterStageRoot)quaternius-medieval-weapons-bow-wooden.cfmesh"
          Link="content/chronofall/character-presentation/client/quaternius-medieval-weapons-bow-wooden.cfmesh"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(StarfallCharacterStageRoot)quaternius-medieval-weapons-bow-wooden.provenance.json"
          Link="content/chronofall/character-presentation/client/quaternius-medieval-weapons-bow-wooden.provenance.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(StarfallCharacterStageRoot)licenses/quaternius-ual1-standard/License.txt"
          Link="content/chronofall/character-presentation/client/licenses/quaternius-ual1-standard/License.txt"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(StarfallCharacterStageRoot)licenses/quaternius-ual1-standard/README.txt"
          Link="content/chronofall/character-presentation/client/licenses/quaternius-ual1-standard/README.txt"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(StarfallCharacterStageRoot)licenses/quaternius-ual2-source/License.txt"
          Link="content/chronofall/character-presentation/client/licenses/quaternius-ual2-source/License.txt"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(StarfallCharacterStageRoot)licenses/quaternius-ual2-source/README.txt"
          Link="content/chronofall/character-presentation/client/licenses/quaternius-ual2-source/README.txt"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(StarfallCharacterStageRoot)licenses/quaternius-medieval-weapons/License.txt"
          Link="content/chronofall/character-presentation/client/licenses/quaternius-medieval-weapons/License.txt"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(ChronoFallEffectiveRuntimeIdentifier)' == 'osx-arm64'">
    <None Include="$(ChronoFallFamilyRoot)thirdparty/repos/SDL3-CS/native/osx-arm64/libSDL3.dylib"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="runtimes/osx-arm64/native/libSDL3.dylib" />
  </ItemGroup>

  <Target Name="EnsureStarfallCharacterPresentationStage" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(StarfallCharacterStageRoot)quaternius-ual1-standard.cfskel')"
           Text="Starfall character content is not staged. From the ChronoFall coordinator root run: scripts/cook-character-presentation-for-client.sh --project-id prj_pkIpzx0fzFD4URjvqBuYrGZF" />
    <Error Condition="!Exists('$(StarfallCharacterStageRoot)quaternius-ual1-standard.provenance.json')"
           Text="Starfall character provenance is not staged. Re-run the stable-ID coordinator staging command." />
    <Error Condition="!Exists('$(StarfallCharacterStageRoot)quaternius-ual2-source-bow-shot-body.cfskel') Or !Exists('$(StarfallCharacterStageRoot)quaternius-ual2-source-bow-shot-body.provenance.json')"
           Text="Starfall Basic Arrow bow-body content is not staged. From the ChronoFall coordinator root set CHRONOFALL_UAL2_SOURCE_ROOT and run: scripts/cook-character-presentation-for-client.sh --project-id prj_pkIpzx0fzFD4URjvqBuYrGZF --ual2-source-root &quot;$CHRONOFALL_UAL2_SOURCE_ROOT&quot;" />
    <Error Condition="!Exists('$(StarfallCharacterStageRoot)quaternius-medieval-weapons-bow-wooden.cfmesh')"
           Text="Starfall Basic bow content is not staged. Re-run the stable-ID coordinator staging command." />
    <Error Condition="!Exists('$(StarfallCharacterStageRoot)quaternius-medieval-weapons-bow-wooden.provenance.json')"
           Text="Starfall Basic bow provenance is not staged. Re-run the stable-ID coordinator staging command." />
    <Error Condition="!Exists('$(StarfallCharacterStageRoot)licenses/quaternius-ual1-standard/License.txt') Or !Exists('$(StarfallCharacterStageRoot)licenses/quaternius-ual1-standard/README.txt')"
           Text="Starfall character CC0 evidence is incomplete. Re-run the stable-ID coordinator staging command." />
    <Error Condition="!Exists('$(StarfallCharacterStageRoot)licenses/quaternius-ual2-source/License.txt') Or !Exists('$(StarfallCharacterStageRoot)licenses/quaternius-ual2-source/README.txt')"
           Text="Starfall UAL2 Source CC0 evidence is incomplete. Re-run the stable-ID coordinator staging command with CHRONOFALL_UAL2_SOURCE_ROOT." />
    <Error Condition="!Exists('$(StarfallCharacterStageRoot)licenses/quaternius-medieval-weapons/License.txt')"
           Text="Starfall Basic bow CC0 evidence is incomplete. Re-run the stable-ID coordinator staging command." />
  </Target>

  <Target Name="CopyChronoFallCharacterPresentationShaders" AfterTargets="Build">
    <ItemGroup>
      <CharacterPresentationShaderAsset Include="$(ChronoFallFamilyRoot)src/ChronoFall.CharacterPresentation.SdlGpu/bin/$(Configuration)/$(TargetFramework)/shaders/**/*.msl" />
      <CharacterPresentationShaderAsset Include="$(ChronoFallFamilyRoot)src/ChronoFall.CharacterPresentation.SdlGpu/bin/$(Configuration)/$(TargetFramework)/shaders/**/*.spv" />
    </ItemGroup>
    <Copy SourceFiles="@(CharacterPresentationShaderAsset)"
          DestinationFiles="@(CharacterPresentationShaderAsset->'$(OutputPath)shaders/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
